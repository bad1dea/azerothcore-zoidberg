[worldserver]

########################################
# mod-idlebot configuration
#
# Private-server-only guide-assisted playerbot controller.
# Copy to mod_idlebot.conf to override; the .dist is the documented default.
########################################

#
#    IdleBot.Enabled
#        Master switch for the module. 0 = module loads but does nothing.
#        Default: 0  (off until you have verified the build)
IdleBot.Enabled = 0

#
#    IdleBot.TickMs
#        How often the bot manager advances bot state, in milliseconds.
#        One small action per bot per tick. Do NOT set this very low.
#        Default: 1000
IdleBot.TickMs = 1000

#
#    IdleBot.MaxActiveBots
#        Hard cap on bots this module will actively drive at once.
#        Default: 5
IdleBot.MaxActiveBots = 10

#
#    IdleBot.AllowGMOnly
#        If 1, the .idlebot command set is GM-only. Strongly recommended on.
#        Default: 1
IdleBot.AllowGMOnly = 1

#
#    IdleBot.GuideDirectory
#        Path (relative to worldserver working dir, or absolute) to guide YAML.
#        Default: ./modules/mod-idlebot/data/guides
IdleBot.GuideDirectory = "./modules/mod-idlebot/data/guides"

#
#    IdleBot.UsePlayerbots
#        1 = drive real mod-playerbots characters. 0 = dry-run / no bot control
#        (useful for testing command parsing without a live bot).
#        Default: 1
IdleBot.UsePlayerbots = 1

#
#    IdleBot.ControlMode
#        How the bridge controls bots: "chat" (prototype, chat commands) or
#        "internal" (direct mod-playerbots calls — later, once verified).
#        Default: chat
IdleBot.ControlMode = "chat"

#
#    IdleBot.DecisionMode
#        Default decision mode for new goals:
#        strict | assisted | autonomous | sandbox
#        Default: strict
IdleBot.DecisionMode = "strict"

# --- Randomization (M6+; ignored until implemented) ---
IdleBot.EnableRandomization = 0
IdleBot.RandomDelayMinMs = 250
IdleBot.RandomDelayMaxMs = 1500

# --- Safety / failure handling ---
IdleBot.StuckTimeoutSec = 60
IdleBot.MaxDeathsBeforePause = 5
IdleBot.MaxDeathsBeforeReroute = 3
IdleBot.MaxQuestFailureMinutes = 15
IdleBot.MaxDropFarmMinutes = 20

# --- Death handling (Priority 2) ---
#   The playerbots DeadStrategy already auto-releases, runs to the corpse, and
#   revives. idlebot observes + counts deaths, lets playerbots recover, and only
#   nudges / falls back when recovery stalls.
#
#   Enabled                 master switch for idlebot death observation/recovery.
#   AllowDirectResurrect    last-resort core ResurrectPlayer (private-server only).
#   AllowGraveyardResurrect allow "spirit healer" graveyard revive before direct.
#   MaxCorpseRunAttempts    idlebot revive-from-corpse nudges before escalating.
#   MaxDeathsPerStep        deaths on one guide step before pausing for review.
#   PauseAfterDeathLoop     pause the bot after a death loop (else keep retrying).
#   GhostStallTicks         ticks spent as a ghost before idlebot starts nudging
#                           (gives the playerbots corpse-run a head start).
#   NoSkipBelowLevel        below this level a quest is NEVER skipped on a death/stuck
#                           loop — early/starter quests must complete, not be abandoned.
#                           The bot re-attempts (and is relocated to the step anchor if
#                           it drifted into over-level mobs). 0 = always allow skipping.
#   RescueRelocateBelowLevel  when refusing to skip below NoSkipBelowLevel, teleport the
#                           bot back to the current step's anchor so it re-approaches
#                           from the right place instead of dying where it drifted.
#   MaxRescueRelocates      max rescue-relocate cycles on the same step before
#                           force-skipping even below NoSkipBelowLevel. Breaks infinite
#                           death-relocate loops on genuinely unwinnable content. 0 = no cap.
IdleBot.DeathHandling.Enabled = 1
IdleBot.DeathHandling.AllowDirectResurrect = 1
IdleBot.DeathHandling.AllowGraveyardResurrect = 1
IdleBot.DeathHandling.MaxCorpseRunAttempts = 3
IdleBot.DeathHandling.MaxDeathsPerStep = 3
IdleBot.DeathHandling.PauseAfterDeathLoop = 1
IdleBot.DeathHandling.GhostStallTicks = 8
IdleBot.DeathHandling.NoSkipBelowLevel = 20
IdleBot.DeathHandling.RescueRelocateBelowLevel = 1
IdleBot.DeathHandling.MaxRescueRelocates = 2

# --- Inventory / town maintenance (Priority 5) ---
#   Before grind/quest steps, check free bag slots and equipped durability. Repair
#   / vendor via playerbots actions (these only succeed near the relevant NPC; the
#   bot is not blocked when out of town — town-hub routing is a later milestone).
#
#   TownMaintenance.Enabled            master switch for the inventory guard.
#   Inventory.MinFreeSlotsBeforeQuest  guard threshold before quest/gameobject steps.
#   Inventory.MinFreeSlotsBeforeGrind  guard threshold before kill/grind steps.
#   VendorFreeMaintenance              allow food/drink/ammo class upkeep without
#                                      forcing a real vendor trip first.
#   TownMaintenance.RepairBelowDurabilityPct  repair when lowest equipped item is
#                                             below this percentage.
IdleBot.TownMaintenance.Enabled = 1
IdleBot.Inventory.MinFreeSlotsBeforeQuest = 2
IdleBot.Inventory.MinFreeSlotsBeforeGrind = 4
IdleBot.VendorFreeMaintenance = 0
IdleBot.TownMaintenance.RepairBelowDurabilityPct = 40

# --- Contested gameobject handling ---
#   InteractGameObject steps now behave like a player waiting on a contested
#   chest / box / click-object: keep searching, pause between retries, roam the
#   objective area, and never advance a required step just because the object is
#   currently missing.
IdleBot.GameObject.WaitForRespawn = 1
IdleBot.GameObject.RetryEverySec = 5
IdleBot.GameObject.RoamEverySec = 20
IdleBot.GameObject.RequiredMaxWaitMinutes = 0
IdleBot.GameObject.OptionalMaxWaitMinutes = 15
IdleBot.GameObject.DefaultSearchRadius = 60
IdleBot.GameObject.RoamRadius = 35

# --- Play like a player: gear/bags ---
#   AutoGear = 0 (default): idlebot bots acquire gear+bags via LOOT and VENDOR
#   purchases, like a player. The playerbots factory's auto-gear/auto-bag handout
#   is suppressed (requires AiPlayerbot.RandomizeManagedBots = 0 in playerbots.conf
#   so RandomPlayerbotMgr does not randomize/re-gear externally-managed bots).
#   Set to 1 to let playerbots auto-gear the bot.
IdleBot.AutoGear = 0

#   GiveBags             give bots 4x24-slot bags on login (cheat for testing).
#                        Disable for player-like progression where bots earn bags.
IdleBot.GiveBags = 1

# --- Adaptive combat (smart engagement modes) ---
#   The kill executor picks a MODE each tick from the live situation (class/range,
#   nearby attackable mobs, how many are attacking, cluster size, hp/mana); the
#   playerbots per-class rotation does the actual casting.
#     MaxPull       attackers before the bot stops pulling more.
#     LowHpPct      eat/drink (recover) below this health %.
#     LowManaPct    drink below this mana % when safe (not in combat, no attackers).
#     AoeThreshold  cluster size at which to switch on the +aoe combat strategy.
#     RangedKite    ranged classes back off when attacked (1=on).
#     CriticalHpPct        flee ANY fight (even a 1v1) below this health % — don't
#                          fight to the death; back off, regen, re-approach.
#     RestBeforePullHpPct  top off health to at least this % before pulling the NEXT
#                          mob (no chain-pulling at half health — the top low-level
#                          death cause). Set 0 to disable resting between pulls.
#     RestBeforePullManaPct same, for mana (casters/healers); non-mana classes ignore.
#     RestMaxTicks         stop resting and pull anyway after this many ticks (so a bot
#                          with no food / slow regen never stalls forever).
IdleBot.Combat.MaxPull = 3
IdleBot.Combat.LowHpPct = 35
IdleBot.Combat.LowManaPct = 20
IdleBot.Combat.AoeThreshold = 3
IdleBot.Combat.CriticalHpPct = 25
IdleBot.Combat.RestBeforePullHpPct = 70
IdleBot.Combat.RestBeforePullManaPct = 50
IdleBot.Combat.RestMaxTicks = 30
IdleBot.Combat.RangedKite = 1

# --- Adaptive toggles (decision engine; M7+) ---
IdleBot.AllowQuestSkipping = 0
IdleBot.AllowOptionalGrinding = 0
IdleBot.AllowDynamicQuestSelection = 0
IdleBot.AllowCrowdedAreaAvoidance = 0
IdleBot.AllowOverlevelQuestSkipping = 0
IdleBot.AllowUnderlevelGrinding = 0
IdleBot.AllowTownMaintenance = 0

# --- Social / grouping (M8+; OFF by default, by design) ---
IdleBot.AllowGroupingWithPlayers = 0
IdleBot.AllowAcceptGroupInvites = 0
IdleBot.AllowInviteNearbyPlayers = 0
IdleBot.GroupingLevelTolerance = 4
IdleBot.SocialInviteCooldownSec = 300
IdleBot.SocialWhisperCooldownSec = 120

# --- Per-bot logging ---
#
#    IdleBot.Log.PerBot.Enabled
#        Write one "<botName>.log" per registered bot, capturing idlebot's own
#        activity (lifecycle now; movement/quests/combat in later milestones).
#        Works even when IdleBot.Enabled = 0.
#        Default: 1
IdleBot.Log.PerBot.Enabled = 1

#
#    IdleBot.Log.Directory
#        Where the per-bot .log files go. Empty = "<LogsDir>/idlebot". Set an
#        absolute path to a host-bind-mounted dir to read the logs outside the
#        container (e.g. the data volume).
#        Default: "" (-> <LogsDir>/idlebot)
IdleBot.Log.Directory = ""

#
#    IdleBot.Log.CaptureChat
#        Also mirror the bot's in-world chat (say/yell/emote/whisper/party/
#        guild/channel) into its per-bot log. NOTE: mod-playerbots whispers sent
#        to a real master use a raw packet and are NOT captured; master-less
#        bot say/yell/whisper IS.
#        Default: 1
IdleBot.Log.CaptureChat = 1

# --- Telemetry / debug ---
IdleBot.Telemetry.Enabled = 1
IdleBot.Debug.Enabled = 0
